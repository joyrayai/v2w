PORT=5174
HOST_PORT=5174
PUBLIC_BASE_URL=http://localhost:5174
SESSION_SECRET=change-me-to-a-long-random-secret
APP_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
SESSION_TTL_DAYS=7
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MS=900000
DATA_DIR=
OUTPUT_DIR=
CACHE_DIR=

MAX_CONCURRENCY=5
MAX_USER_RUNNING=2
MAX_USER_QUEUED=50
MIN_FREE_DISK_GB=6
CACHE_MAX_BYTES=5368709120
FAILED_CACHE_TTL_HOURS=24
REVIEW_CONTEXT_LIMIT_TOKENS=1000000
DELIVERY_TIMEOUT_MS=30000
DELIVERY_ALLOW_PRIVATE_URLS=false
MCP_LEGACY_TOOLS=false
BAIDUPCS_GO_VERSION=v4.0.1
INSTALL_CHROMIUM=false
APT_DEBIAN_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://deb.debian.org/debian-security

# Optional: use a closer Debian mirror if Docker build downloads are slow.
# APT_DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
# APT_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security

# Optional: set when Chromium/Chrome is not available on PATH.
# CHROME_PATH=/usr/bin/google-chrome
# CHROMIUM_PATH=/usr/bin/chromium
